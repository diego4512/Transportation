# BKK Futár / Budapest GO API kulcs (https://opendata.bkk.hu). Üresen hagyva csak menetrend (GTFS) alapon működik.
BKK_API_KEY=
# Szerver port
PORT=8787
# Adatkönyvtár (SQLite adatbázis, VAPID kulcsok)
DATA_DIR=./data
# GTFS forrás
GTFS_URL=https://go.bkk.hu/api/static/v1/public-gtfs/budapest_gtfs.zip
# Web Push kapcsolattartó (VAPID subject)
VAPID_SUBJECT=mailto:admin@example.com
